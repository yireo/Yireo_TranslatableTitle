{
    "name": "yireo/magento2-translatabletitle",
    "license": "OSL-3.0",
    "type": "magento2-module",
    "homepage": "https://github.com/yireo/Yireo_TranslatableTitle",
    "description": "Magento 2 extension to make plain string page titles translatable in the frontend",
    "keywords": [
        "composer-installer",
        "magento"
    ],
    "require": {
        "magento/framework": "^100.1|^101.0|^102.0|^103.0",
        "magento/module-store": "^101.1",
        "php": ">=8.2 <8.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "yireo/magento2-integration-test-helper": "~0.0.23"
    },
    "autoload": {
        "psr-4": {
            "Yireo\\TranslatableTitle\\": ""
        },
        "files": [
            "registration.php"
        ]
    },
    "version": "0.0.2"
}